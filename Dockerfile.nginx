# Base image pinned by digest for reproducible, supply-chain-safe builds.
# Dependabot (docker ecosystem) bumps the digest below when the pinned tag is
# rebuilt. The tag is named once, on the FROM line — restating it here is what
# went stale for three months (#235 moved it off 1.27 and left this sentence).
FROM nginx:1.31-alpine@sha256:62ff2089abf5a9ed33bd232895bef5e22f7bb4b200675cec49a5ebc48e3d4ac8
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
# Shared response headers, `include`d by default.conf from every location that
# declares an add_header of its own (nginx replaces the inherited set, so each
# one must restate it). Not under conf.d/ — files there are auto-loaded into the
# http context, and these are location-context directives.
COPY nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY nginx/favicon.svg /usr/share/nginx/html/favicon.svg
RUN echo '<!DOCTYPE html><html><body>Dashboard not mounted.</body></html>' > /usr/share/nginx/html/index.html \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && chmod -R 755 /usr/share/nginx/html \
    && touch /run/nginx.pid && chown nginx:nginx /run/nginx.pid
EXPOSE 8080
USER nginx
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -qO /dev/null http://127.0.0.1:8080/ || exit 1
